# ==========================================================
# AUCA WORKLOAD MANAGEMENT SYSTEM
# ENVIRONMENT SETTINGS
# ==========================================================
#
# Copy this file to `.env` in the same folder as manage.py and
# uncomment the lines you need:
#
#     cp .env.example .env
#
# `config/settings.py` reads that file on startup, so this
# works the same on Windows, macOS and Linux -- no `export`,
# no systemd unit, nothing extra to install. Restart the
# server after changing it.
#
# A real environment variable always beats the file, so a
# server that sets EMAIL_HOST in its own configuration is not
# overridden by a stray `.env` left in the checkout.
#
# Check what the system actually picked up with:
#
#     python manage.py check_email
#
# NOTHING HERE IS REQUIRED TO RUN THE SYSTEM LOCALLY. With none
# of it set, the site runs on 127.0.0.1 and every notification
# email is printed to the terminal running runserver, so you
# can read exactly what a lecturer would receive.
#
# Do not commit a filled-in copy of this file.
# ==========================================================


# ----------------------------------------------------------
# EMAIL
#
# Set EMAIL_HOST and the system switches from printing emails
# to sending them. Leave it unset and everything still works,
# it just goes to the console.
#
# For Gmail, EMAIL_HOST_PASSWORD must be an App Password
# generated at https://myaccount.google.com/apppasswords --
# the account's own password will be rejected.
# ----------------------------------------------------------

# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=workload@auca.ac.rw
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=AUCA Workload Management System <no-reply@auca.ac.rw>

# Force a specific backend regardless of the above. Useful for
# a staging server that should never send real mail:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend


# ----------------------------------------------------------
# SITE ADDRESS
#
# This is what makes the links inside a notification email
# absolute. Get it wrong and every lecturer receives a link to
# 127.0.0.1, which works only on the server itself.
# ----------------------------------------------------------

# SITE_URL=https://workload.auca.ac.rw


# ----------------------------------------------------------
# DEPLOYMENT
#
# All three must be set before the system faces real users.
# ----------------------------------------------------------

# DEBUG=0
# ALLOWED_HOSTS=workload.auca.ac.rw,10.0.0.5
# CSRF_TRUSTED_ORIGINS=https://workload.auca.ac.rw

# Generate a fresh one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# SECRET_KEY=replace-me
